[Unit]
Description=EIS Parser Background Worker (Stage 1-4)
After=network.target

[Service]
Type=simple
User=eisparser
Group=eisparser
WorkingDirectory=/opt/eisparser
EnvironmentFile=/opt/eisparser/src/.env
ExecStart=/opt/eisparser/.venv/bin/python /opt/eisparser/src/main.py worker --interval 300 --limit 10 --top-n 10
Restart=on-failure
RestartPreventExitStatus=75
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
