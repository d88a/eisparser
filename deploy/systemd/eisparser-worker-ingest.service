[Unit]
Description=EIS Parser Ingest Worker (Stage 1-2)
After=network.target

[Service]
Type=simple
User=eisparser
Group=eisparser
WorkingDirectory=/opt/eisparser
EnvironmentFile=/opt/eisparser/src/.env
ExecStart=/opt/eisparser/.venv/bin/python /opt/eisparser/src/main.py worker-ingest --interval 300 --limit 10
Restart=on-failure
RestartPreventExitStatus=75
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
