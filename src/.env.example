# EIS Parser Configuration
# Скопируйте этот файл как .env и заполните значения

# Cerebras AI (OpenAI-compatible)
CEREBRAS_API_KEY=your_api_key_here
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b

# Admin auth
ADMIN_PASSWORD=change_me

# Database
DATABASE_PATH=../results/eis_data.db

# Scraper settings
STAGE4_HEADLESS=true
STAGE4_USE_REAL_CHROME=true
STAGE4_PAGE_TIMEOUT_S=60

# AI (Stage 2)
AI_STAGE2_DELAY_S=2.0

# Proxy (optional)
# PROXY_URL=http://user:pass@host:port
