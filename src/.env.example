# EIS Parser Configuration
# Скопируйте этот файл как .env и заполните значения

# Cerebras AI (OpenAI-compatible)
CEREBRAS_API_KEY=your_api_key_here
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b

# Admin auth
ADMIN_PASSWORD=change_me
# Optional but strongly recommended:
# ADMIN_TOKEN_SECRET=change_me_separately
# ADMIN_SECURITY_FAIL_FAST=true

# User API access mode:
# PUBLIC (default) | AUTH_REQUIRED
USER_ACCESS_MODE=PUBLIC

# Dev server reload (production default should remain false)
SERVER_RELOAD=false

# Database
# If DATABASE_URL is set, PostgreSQL is used.
# If DATABASE_URL is empty, SQLite fallback via DATABASE_PATH is used.
# DATABASE_URL=postgresql://user:pass@host:5432/eisparser
DATABASE_PATH=../results/eis_data.db

# Scraper settings
STAGE4_HEADLESS=true
STAGE4_USE_REAL_CHROME=true
STAGE4_PAGE_TIMEOUT_S=60

# Worker settings
# Set false on hosting to run only Stage 1-3 there.
WORKER_ENABLE_STAGE4=true

# AI (Stage 2)
AI_STAGE2_DELAY_S=2.0
CEREBRAS_MODEL=gpt-oss-120b

# Stage 1 scan depth (pages)
STAGE1_MAX_PAGES=10

# Proxy (optional)
# PROXY_URL=http://user:pass@host:port
